# npm start does not automatically load .env. On Node 24, use:
# node --env-file=.env server.js
# Leave DATABASE_URL unset for local SQLite development.
# For Neon, paste the actual connection string only into Render Environment.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full

PORT=3000
# Render automatically supplies RENDER_EXTERNAL_URL for its assigned domain.
# Set PUBLIC_ORIGIN only for a custom domain or another reverse proxy.
# PUBLIC_ORIGIN=https://your-domain.example
# COOKIE_SECURE=1
